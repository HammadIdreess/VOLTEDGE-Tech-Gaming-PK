# ==========================================
# VoltEdge E-Commerce Environment Configuration
# ==========================================

# Application
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3000

# Database (PostgreSQL 16)
# Default for local Docker: postgresql://postgres:postgrespassword@localhost:5432/voltedge_db?schema=public
# Or for local embedded/managed PostgreSQL:
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/voltedge_db?schema=public

# Direct URL for Prisma migrations if using PgBouncer / Connection Pooler
DIRECT_URL=postgresql://postgres:postgrespassword@localhost:5432/voltedge_db?schema=public

# Authentication (NextAuth / Auth.js)
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=voltedge-secure-development-secret-key-at-least-32-chars-long!
NEXTAUTH_URL=http://localhost:3000

# Initial Admin Bootstrap Seed (Development / Setup only)
INITIAL_ADMIN_EMAIL=admin@voltedge.pk
INITIAL_ADMIN_PASSWORD=AdminVoltEdge2026!
INITIAL_ADMIN_NAME="VoltEdge Admin"

# Store Settings & Regional Defaults
NEXT_PUBLIC_STORE_NAME=VoltEdge
NEXT_PUBLIC_STORE_CURRENCY=PKR
NEXT_PUBLIC_STORE_COUNTRY=PK
NEXT_PUBLIC_SUPPORT_EMAIL=support@voltedge.pk
NEXT_PUBLIC_SUPPORT_PHONE="+92 300 1234567"

# Payment Gateways (Optional / Production)
# Set to 'test' or 'sandbox' for staging environments
PAYMENT_PROVIDER_MODE=test
PAYMENT_PROVIDER_SECRET=test_secret_placeholder
PAYMENT_WEBHOOK_SECRET=test_webhook_secret_placeholder

# Transactional Email (Optional)
EMAIL_SERVER_HOST=smtp.example.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=apikey
EMAIL_SERVER_PASSWORD=secret_smtp_password
EMAIL_FROM=no-reply@voltedge.pk
